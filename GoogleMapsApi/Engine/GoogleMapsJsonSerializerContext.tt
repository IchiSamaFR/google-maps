<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ assembly name="System.Runtime" #>
<#@ import namespace="System" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ output extension=".cs" #>
<#
    // -------------------------------------------------------------------------
    // Scan directories
    // -------------------------------------------------------------------------
    string[] scanDirectories = new[]
    {
        Host.ResolvePath(@"..\Entities"),
        Host.ResolvePath(@"..\StaticMaps\Entities"),
    };

    var nsRegex    = new Regex(@"^\s*namespace\s+([\w\.]+)", RegexOptions.Multiline);
    var classRegex = new Regex(@"^\s*public\s+(?:\w+\s+)*class\s+(\w+)", RegexOptions.Multiline);
    var enumRegex  = new Regex(@"^\s*(?:public\s+)?enum\s+(\w+)", RegexOptions.Multiline);

    // (Namespace, ClassName, IsEnum)
    var allTypes = new List<(string Namespace, string TypeName, bool IsEnum)>();

    foreach (var dir in scanDirectories)
    {
        if (!Directory.Exists(dir)) continue;

        foreach (var file in Directory.EnumerateFiles(dir, "*.cs", SearchOption.AllDirectories))
        {
            var content = File.ReadAllText(file);

            var nsMatch = nsRegex.Match(content);
            if (!nsMatch.Success) continue;
            string ns = nsMatch.Groups[1].Value.Trim();

            // Exclude classes marked with [Obsolete]
            var classMatches = classRegex.Matches(content);
            foreach (Match cm in classMatches)
            {
                int classIndex = cm.Index;
                string beforeClass = content.Substring(0, classIndex);
                string lastLines = beforeClass.Length > 200 ? beforeClass.Substring(beforeClass.Length - 200) : beforeClass;
                if (Regex.IsMatch(lastLines, @"\[Obsolete[^\]]*\]\s*$", RegexOptions.Multiline))
                    continue; // Skip this class

                allTypes.Add((ns, cm.Groups[1].Value.Trim(), false));
            }

            foreach (Match em in enumRegex.Matches(content))
                allTypes.Add((ns, em.Groups[1].Value.Trim(), true));
        }
    }

    // -------------------------------------------------------------------------
    // Deduplicate and build TypeInfoPropertyName strategy
    // For each (TypeName), if more than one namespace → need a unique prefix
    // Prefix = PascalCase segments of namespace after "GoogleMapsApi."
    // e.g. GoogleMapsApi.Entities.Directions.Response → "Directions"
    // -------------------------------------------------------------------------
    allTypes = allTypes
        .Where(t => t.Namespace.StartsWith("GoogleMapsApi.Entities"))
        .GroupBy(t => (t.Namespace, t.TypeName))
        .Select(g => g.First())
        .OrderBy(t => t.Namespace).ThenBy(t => t.TypeName)
        .ToList();

    // Count how many distinct namespaces expose the same TypeName
    var typeNameCount = allTypes
        .GroupBy(t => t.TypeName)
        .ToDictionary(g => g.Key, g => g.Count());

    // Build a friendly namespace prefix: last non-"Response"/"Request" segment before Response/Request
    Func<string, string> NsPrefix = (ns) =>
    {
        var parts = ns.Split('.');
        var meaningful = parts
            .Where(p => p != "GoogleMapsApi" && p != "Entities"
                     && p != "Response"      && p != "Request"
                     && p != "Enums")
            .ToArray();
        return meaningful.Length > 0 ? string.Join("", meaningful) : parts.Last();
    };

    // (Namespace, TypeName, IsEnum, TypeInfoPropertyName or null)
    var entries = allTypes.Select(t =>
    {
        string tip = typeNameCount[t.TypeName] > 1
            ? NsPrefix(t.Namespace) + t.TypeName
            : null;
        return (t.Namespace, t.TypeName, t.IsEnum, tip);
    }).ToList();

    // Separate Response types (classes) that are NOT enums
    var classEntries = entries.Where(e => !e.IsEnum).ToList();

    // Separate Response types (enums)
    var enumEntries = entries.Where(e => e.IsEnum).ToList();

    // Collect IEnumerable entries for classes that appear in Result-like or collection properties
    // Strategy: add IEnumerable<T> for every class that has a TypeInfoPropertyName (likely used in lists)
    var iEnumerableEntries = classEntries
        .Where(e => e.tip != null)
        .Select(e => (e.Namespace, e.TypeName, TypeInfoPropertyName: "IEnumerable" + e.tip))
        .ToList();
#>
// <auto-generated>
//     This file was automatically generated by GoogleMapsJsonSerializerContext.tt
//     DO NOT MODIFY MANUALLY — re-run the T4 template to update.
// </auto-generated>
using GoogleMapsApi.Engine.JsonConverters;
using System.Collections.Generic;
using System.Text.Json.Serialization;

namespace GoogleMapsApi.Engine
{
    /// <summary>
    /// Source-generated JSON serializer context for Google Maps API entities, configured with custom converters.
    /// </summary>
<#
    // ---- Classes (sorted by name) ----
    foreach (var e in classEntries.OrderBy(e => e.TypeName))
    {
        string fullName = $"{e.Namespace}.{e.TypeName}";
        if (e.tip != null)
        {
#>
    [JsonSerializable(typeof(<#= fullName #>), TypeInfoPropertyName = "<#= e.tip #>")]
<#
        }
        else
        {
#>
    [JsonSerializable(typeof(<#= fullName #>))]
<#
        }
    }

    // ---- IEnumerable<T> for ambiguous classes ----
    foreach (var e in iEnumerableEntries.OrderBy(e => e.TypeInfoPropertyName))
    {
        string fullName = $"{e.Namespace}.{e.TypeName}";
#>
    [JsonSerializable(typeof(IEnumerable<<#= fullName #>>), TypeInfoPropertyName = "<#= e.TypeInfoPropertyName #>")]
<#
    }
        // ---- Enums (sorted by name) ----
    foreach (var e in enumEntries.OrderBy(e => e.TypeName))
    {
        string fullName = $"{e.Namespace}.{e.TypeName}";
        if (e.tip != null)
        {
#>
    [JsonSerializable(typeof(<#= fullName #>), TypeInfoPropertyName = "<#= e.tip #>")]
<#
        }
        else
        {
#>
    [JsonSerializable(typeof(<#= fullName #>))]
<#
        }
    }
#>
    [JsonSerializable(typeof(object))]

    [JsonSourceGenerationOptions(
        PropertyNameCaseInsensitive = true,
        Converters = new[]
        {
            typeof(EnumMemberJsonConverterFactory),
            typeof(PriceLevelJsonConverter),
            typeof(OverviewPolylineJsonConverter),
            typeof(DurationJsonConverter<GoogleMapsApi.Entities.DistanceMatrix.Response.Duration>),
            typeof(DurationJsonConverter<GoogleMapsApi.Entities.Directions.Response.Duration>),
        })]
